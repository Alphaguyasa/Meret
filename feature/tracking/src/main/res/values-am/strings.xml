<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="tracks_empty_title">እስካሁን ምንም መስመር የለም</string>
    <string name="tracks_empty_body">የሚሄዱበትን መንገድ መመዝገብ ለመጀመር በካርታው ላይ መቅዳት ይጫኑ። መስመሮች መጀመሪያ በዚህ መሣሪያ ላይ ይቀመጣሉ።</string>
    <string name="tracking_channel_name">መስመር መቅዳት</string>
    <string name="tracking_channel_description">መስመር እየተቀዳ እያለ ርቀቱን እና የማቆሚያ ቁልፎችን ያሳያል።</string>
    <string name="tracking_notification_starting">ጂፒኤስ በመጀመር ላይ…</string>
    <string name="tracking_notification_recording">መስመር እየተቀዳ ነው</string>
    <string name="tracking_notification_paused">መቅዳት ለጊዜው ቆሟል</string>
    <string name="tracking_notification_stats">%1$.2f ኪ.ሜ · ነጥቦች፦ %2$d</string>
    <string name="tracking_action_pause">ለጊዜው አቁም</string>
    <string name="tracking_action_resume">ቀጥል</string>
    <string name="tracking_action_stop">አቁም</string>
    <string name="tracking_interrupted_channel_name">የተቋረጡ መስመሮች</string>
    <string name="tracking_interrupted_channel_description">መስመር እየተቀዳ ሳለ ስልኩ እንደገና ሲጀምር ይታያል፤ ለመቀጠል የሚያስችል ቁልፍ አለው።</string>
    <string name="tracking_interrupted_title">መስመሩ አልተጠናቀቀም</string>
    <string name="tracking_interrupted_body">መስመር እየተቀዳ ሳለ ስልኩ እንደገና ጀምሯል። የተቀዳው ሁሉ ተቀምጧል። ያንኑ መስመር ለመቀጠል «መቅዳት ቀጥል»ን ይጫኑ።</string>
    <string name="tracking_action_resume_track">መቅዳት ቀጥል</string>
</resources>

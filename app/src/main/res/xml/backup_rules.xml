<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below (API 23-30). Same rule as data_extraction_rules.xml: nothing is
    backed up. allowBackup="false" already disables this path; the excludes are a second
    lock in case that attribute is ever flipped. Guarded by BackupRulesTest.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
